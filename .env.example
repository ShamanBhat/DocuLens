# ─────────────────────────────────────────────────────────────────────────────
#  DocuLens · environment configuration
#
#  DocuLens runs 100% in the browser by default: NO key is required for the
#  on-device WebGPU models. Everything below is optional.
#  Copy to `.env.local` to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── On-device engine (public: these values are bundled into the client) ──────

# Model selected on first load. Any text-generation ONNX repo from Hugging Face.
# Built-ins: onnx-community/Qwen2.5-0.5B-Instruct (default, ~495 MB),
#            HuggingFaceTB/SmolLM2-360M-Instruct (~276 MB),
#            onnx-community/Qwen2.5-1.5B-Instruct (~1.2 GB)
NEXT_PUBLIC_DEFAULT_LOCAL_MODEL=onnx-community/Qwen2.5-0.5B-Instruct

# Start downloading the model immediately on first visit. Set to "off" to wait
# for a click. (Always deferred when the browser reports Data Saver.)
NEXT_PUBLIC_AUTO_DOWNLOAD=on

# Where model weights are fetched from. Point at a mirror or a self-hosted
# proxy for air-gapped / regional setups. Must follow the Hub URL layout.
# NEXT_PUBLIC_HF_REMOTE_HOST=https://huggingface.co/

# Where the ONNX Runtime .wasm files are served from. Default "/ort/" is copied
# from node_modules on install (no CDN requests). Use "cdn" for the library default.
# NEXT_PUBLIC_ORT_WASM_PATH=/ort/

# ── Optional cloud fallback (server-side only, never sent to the browser) ────
# Cloud models appear in the switcher only when a key is set. Selecting one sends
# the extracted document text to that provider through this app's API routes.
# Set NEXT_PUBLIC_CLOUD_FALLBACK=off to hide cloud models entirely (strict local mode).

# NEXT_PUBLIC_CLOUD_FALLBACK=off

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Default cloud model used by the API routes when the client sends none.
# Format: provider:model-id
DOCULENS_DEFAULT_MODEL=anthropic:claude-sonnet-4-5

# Register additional cloud models without touching code.
# Comma-separated `provider:model-id`, optionally suffixed with `=contextWindowTokens`.
# DOCULENS_EXTRA_MODELS=openai:o3=200000,google:gemini-2.5-flash-lite=1048576
