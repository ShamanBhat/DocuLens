# ─────────────────────────────────────────────────────────────────────────────
#  DocuLens · environment configuration
#  Copy to `.env.local` and set AT LEAST ONE provider key.
#  Models whose provider has no key are shown as disabled in the model switcher.
#  Keys are only ever read on the server — they are never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Default model when the client does not specify one. Format: provider:model-id
# If this model is not in the built-in catalog it is registered automatically.
DOCULENS_DEFAULT_MODEL=anthropic:claude-sonnet-4-5

# Optional: register additional models without touching code.
# Comma-separated `provider:model-id`, optionally suffixed with `=contextWindowTokens`.
# DOCULENS_EXTRA_MODELS=openai:o3=200000,google:gemini-2.5-flash-lite=1048576
